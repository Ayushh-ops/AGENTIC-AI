# ==============================================================
# Multi-Agent Research Assistant - Environment Configuration
# ==============================================================

# Choose your preferred LLM Provider:
# Options:
# 1. Google Gemini: MODEL_NAME=gemini/gemini-2.0-flash (Recommended, fast & free tier available)
# 2. OpenAI:        MODEL_NAME=gpt-4o-mini or gpt-4o
# 3. Groq:          MODEL_NAME=groq/llama-3.3-70b-versatile
# 4. Ollama:        MODEL_NAME=ollama/llama3
MODEL_NAME=gemini/gemini-2.0-flash

# API Keys (Provide at least one LLM key):
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Search Tools (Optional):
# DuckDuckGo and Wikipedia search work out of the box without any key!
# If you have Serper API key for Google Search, add it below:
SERPER_API_KEY=
